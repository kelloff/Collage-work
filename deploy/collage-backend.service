[Unit]
Description=CollageWork FastAPI backend (beck)
After=network.target ollama.service
Wants=ollama.service

[Service]
Type=simple
User=www-data
Group=www-data
WorkingDirectory=/opt/collage-work/beck
EnvironmentFile=/opt/collage-work/beck/.env
ExecStart=/opt/collage-work/beck/env/bin/uvicorn main:app --host 127.0.0.1 --port 8000
Restart=on-failure
RestartSec=5
# Долгие запросы к Ollama: не убивать сервис SIGKILL при restart (по умолчанию 90s).
TimeoutStopSec=120

[Install]
WantedBy=multi-user.target
