# Скопируй в /opt/collage-work/beck/.env и подправь.
# systemd: EnvironmentFile=-/opt/collage-work/beck/.env

OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.1

# Скорость vs полнота JSON: одна задача / один уровень (~5 задач)
OLLAMA_NUM_PREDICT=768
# Один запрос на все уровни (4×5=20 задач)
OLLAMA_MULTI_NUM_PREDICT=2800
# Контекст: меньше — быстрее, но не ставь слишком мало (обрежет ответ)
OLLAMA_NUM_CTX=4096
OLLAMA_TOP_P=0.95
OLLAMA_REPEAT_PENALTY=1.08
OLLAMA_SINGLE_TIMEOUT=300
OLLAMA_MULTI_TIMEOUT=480
OLLAMA_WARMUP_ENABLED=1
OLLAMA_WARMUP_TIMEOUT=90
OLLAMA_WARMUP_NUM_PREDICT=32

# 1 = при пустом пуле сначала один запрос на 20 задач (быстрее по времени),
#     при нехватке — дозаполнение по уровням. 0 = сначала по уровням, потом one-shot.
TASK_MULTI_ONESHOT_FIRST=1
GENERATE_MAX_SECONDS=300

# Цель пула: 180 задач (4 уровня * 45)
TASK_POOL_TARGET_PER_LEVEL=45
TASK_POOL_MIN_TOTAL=180
# Можно оставить 400, но для 180 комфортнее иметь небольшой запас
TASK_POOL_MAX_TOTAL=500
TASK_POOL_REFILL_CHUNK=5

# OPENAI_API_KEY=sk-...

# /check_task: при level>=2 и падении вызова Ollama принять детерминированную проверку (1) или только ошибку (0).
CHECK_TASK_AI_UNAVAILABLE_FALLBACK_DET=1
# Дополнительно включить ИИ и на уровне 1 (0 = только дет. путь, если не level>=2).
# CHECK_TASK_USE_AI=0
