# =============================================================================
# CollageWork backend — шаблон для продакшена (VPS + Ollama на том же хосте)
# =============================================================================
# На сервере:
#   cp env.example .env
#   sudo chown www-data:www-data .env
#   sudo systemctl restart collage-backend
# Проверка: curl -s http://127.0.0.1:8000/health
#
# OPENAI_API_KEY не обязателен — генерация и проверка идут через Ollama.
# Nginx: proxy_read_timeout 600s (см. deploy/nginx-location-proxy-snippet.conf)
# =============================================================================

# --- Ollama :11434 — большая модель (игра + refill пула) ---
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_REFILL_BASE_URL=http://127.0.0.1:11434
OLLAMA_REFILL_MODEL=qwen2.5:3b
OLLAMA_TEMPERATURE=0.1

# Токены: игрок / refill пула / «Новая игра» 20 задач
OLLAMA_NUM_PREDICT=768
OLLAMA_POOL_NUM_PREDICT=750
OLLAMA_POOL_PREDICT_PER_TASK=130
OLLAMA_POOL_TEMPERATURE=0.1
OLLAMA_POOL_SINGLE_TIMEOUT=300
OLLAMA_POOL_NUM_CTX=1536
OLLAMA_MULTI_NUM_PREDICT=2400
OLLAMA_NUM_CTX=4096
OLLAMA_TOP_P=0.95
OLLAMA_REPEAT_PENALTY=1.08

# Таймауты HTTP к Ollama (сек). Не ставьте меньше 120 на проде — будут 503/обрывы.
OLLAMA_SINGLE_TIMEOUT=600
OLLAMA_MULTI_TIMEOUT=900

# 0 на проде — сразу старт ночного refill (warmup конкурирует с Ollama)
OLLAMA_WARMUP_ENABLED=0
OLLAMA_WARMUP_TIMEOUT=90
OLLAMA_WARMUP_NUM_PREDICT=32

# --- Генерация заданий (/generate_tasks, /generate_tasks_multi) ---
# Задания про дату/datetime не генерируются (см. generate_service.py).
# 1 = если пул+Ollama не дали полный набор — ответ 200 с шаблонными задачами (source=fallback).
# 0 = HTTP 503, клиент сам решает (игра → локальный task_data.gd).
GENERATE_FALLBACK_ON_MISS=1
# 1 = сначала один запрос на все уровни (быстрее для «Новой игры» 4×5=20 задач)
TASK_MULTI_ONESHOT_FIRST=1
# Пока только в /health; жёсткий лимит в коде может появиться позже
GENERATE_MAX_SECONDS=300

# --- Пул задач на диске (быстрая выдача без ожидания LLM) ---
TASK_POOL_ENABLED=1
# По умолчанию: /opt/collage-work/beck/tasks_pool.json (рядом с main.py)
# TASK_POOL_PATH=/opt/collage-work/beck/tasks_pool.json

# 4 уровня × 75 = 300 задач в запасе; игра за раз забирает 4×5=20
TASK_POOL_TARGET_PER_LEVEL=75
TASK_POOL_MIN_TOTAL=300
TASK_POOL_MAX_TOTAL=320
TASK_POOL_REFILL_CHUNK=5
TASK_POOL_REFILL_MAX_OLLAMA_ATTEMPTS=2
TASK_POOL_BATCH_MIN_ACCEPT=2
TASK_POOL_REFILL_PAUSE_SEC=2
TASK_POOL_REFILL_ZERO_ADDED_WAIT=8
# Если Ollama не ответил — положить в пул задачи из каталога (тот же уровень)
TASK_POOL_CATALOG_ON_MISS=1
# Lvl 2–3 refill: 0.5b видоизменяет шаблоны каталога (не свободная генерация); 0 = только каталог
OLLAMA_REFILL_CATALOG_VARY=1
OLLAMA_REFILL_CATALOG_VARY_FROM_LEVEL=2
OLLAMA_REFILL_CATALOG_VARY_TO_LEVEL=3
# Пока total < MIN: повтор шаблонов каталога на уровне (fallback, если vary не ответил)
TASK_POOL_CATALOG_REPEAT_FROM_LEVEL=2
# После N пустых батчей на уровне — временно переключиться на другой (refill не залипает)
TASK_POOL_REFILL_SKIP_LEVEL_AFTER=8
# Похожие задачи на уровень: до N в одной группе (вывод/сценарий); 4-я отсекается
TASK_SIMILAR_MAX_PER_GROUP=3
# Пауза между пустыми батчами (сек); цикл не останавливается после первой ошибки
TASK_POOL_REFILL_RETRY_SEC=12
# --- Проверка кода (/check_task), D2: отдельный Ollama :11435 + лёгкая модель ---
OLLAMA_CHECK_BASE_URL=http://127.0.0.1:11435
OLLAMA_CHECK_MODEL=qwen2.5:0.5b
OLLAMA_CHECK_NUM_PREDICT=64
OLLAMA_CHECK_NUM_CTX=1024
CHECK_TASK_AI_TIMEOUT=10
# fail_only = ИИ только если дет. не прошла; always = уровень 2+ всегда через ИИ (5–10 с)
CHECK_TASK_AI_MODE=fail_only
CHECK_TASK_AI_RETRY=0
# 1 = при явном несовпадении stdout не ждать ИИ (~0.3s), только дет. feedback
CHECK_TASK_SKIP_AI_ON_STDOUT_MISMATCH=1
# 1 = если дет. проверка уже дала причину — не ждать Ollama (быстрый ответ)
CHECK_TASK_SKIP_AI_ON_DET_FAIL=1
# 1 = уровень 2+: если вывод совпал с expected — ответ сразу, без Ollama (~0.1s)
CHECK_TASK_FAST_DET_OK=1
# 1 = на уровне 2+ при падении Ollama засчитать детерминированную проверку
CHECK_TASK_AI_UNAVAILABLE_FALLBACK_DET=1
# 1 = вызывать ИИ и на уровне 1; 0 = только дет. правила на уровне 0–1
CHECK_TASK_USE_AI=0
# 1 = фоновый refill пула ждёт, пока идёт /check_task (игровая генерация не блокируется)
OLLAMA_PAUSE_POOL_DURING_CHECK=1

# --- OpenAI (опционально, если нет — только Ollama) ---
# OPENAI_API_KEY=sk-...
